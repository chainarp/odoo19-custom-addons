<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List View -->
    <record id="itx_info_vehicle_part_category_view_list" model="ir.ui.view">
        <field name="name">itx.info.vehicle.part.category.view.list</field>
        <field name="model">itx.info.vehicle.part.category</field>
        <field name="arch" type="xml">
            <list string="Part Categories">
                <field name="code"/>
                <field name="abbr"/>
                <field name="complete_name"/>
                <field name="child_count" string="Children"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="itx_info_vehicle_part_category_view_form" model="ir.ui.view">
        <field name="name">itx.info.vehicle.part.category.view.form</field>
        <field name="model">itx.info.vehicle.part.category</field>
        <field name="arch" type="xml">
            <form string="Part Category">
                <sheet>
                    <field name="active" invisible="True"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g., Engine"/>
                        </h1>
                        <h4>
                            <field name="complete_name" readonly="True"/>
                        </h4>
                    </div>
                    <group>
                        <group>
                            <field name="code" placeholder="e.g., ENGINE"/>
                            <field name="abbr" placeholder="e.g., ENG"/>
                            <field name="parent_id"/>
                        </group>
                        <group>
                            <field name="child_count" readonly="True"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="desc" placeholder="Additional description..."/>
                        </page>
                        <page string="Subcategories" name="children">
                            <field name="child_ids">
                                <list>
                                    <field name="code"/>
                                    <field name="abbr"/>
                                    <field name="name"/>
                                    <field name="child_count" string="Children"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="itx_info_vehicle_part_category_view_search" model="ir.ui.view">
        <field name="name">itx.info.vehicle.part.category.view.search</field>
        <field name="model">itx.info.vehicle.part.category</field>
        <field name="arch" type="xml">
            <search string="Search Part Categories">
                <field name="name"/>
                <field name="code"/>
                <field name="abbr"/>
                <field name="parent_id"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <filter string="Root Categories" name="root" domain="[('parent_id', '=', False)]"/>
                <group>
                    <filter string="Parent" name="groupby_parent" domain="[]" context="{'group_by': 'parent_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="itx_info_vehicle_part_category_action" model="ir.actions.act_window">
        <field name="name">Part Categories</field>
        <field name="res_model">itx.info.vehicle.part.category</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="itx_info_vehicle_part_category_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first part category
            </p>
            <p>
                Define part categories like Engine, Transmission, Suspension, etc.
            </p>
        </field>
    </record>

</odoo>
