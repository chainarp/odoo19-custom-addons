<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Vehicle Parts List View -->
    <record id="product_template_view_list_vehicle_parts" model="ir.ui.view">
        <field name="name">product.template.view.list.vehicle.parts</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <list string="Vehicle Parts">
                <field name="itx_base_code" string="Base Code"/>
                <field name="itx_part_name_id"/>
                <field name="itx_part_brand" optional="show"/>
                <field name="itx_part_number" optional="show"/>
                <field name="itx_spec_id"/>
                <field name="itx_brand_id" optional="hide"/>
                <field name="itx_model_id" optional="hide"/>
                <field name="itx_generation_id" optional="hide"/>
                <field name="itx_part_category_id"/>
                <field name="itx_oem_part_number" optional="hide"/>
                <field name="list_price" string="Price"/>
                <field name="qty_available" string="On Hand" optional="show"/>
            </list>
        </field>
    </record>

    <!-- Inherit Product Template Form View -->
    <record id="product_template_form_view_vehicle_part" model="ir.ui.view">
        <field name="name">product.template.form.vehicle.part</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <!-- Hide standard name field when is_vehicle_part, show itx_part_name_id instead -->
            <field name="name" position="attributes">
                <attribute name="invisible">itx_is_vehicle_part</attribute>
            </field>

            <!-- Show Part Name (Many2one with autocomplete) when is_vehicle_part -->
            <field name="name" position="after">
                <field name="itx_part_name_id"
                       string="Part Name"
                       invisible="not itx_is_vehicle_part"
                       required="itx_is_vehicle_part"
                       placeholder="Type to search part name..."
                       class="o_text_overflow"
                       options="{'no_quick_create': True}"/>
            </field>

            <!-- Add Vehicle Part checkbox in options div -->
            <div name="options" position="inside">
                <span class="d-inline-flex">
                    <field name="itx_is_vehicle_part"/>
                    <label for="itx_is_vehicle_part"/>
                </span>
            </div>

            <!-- Add Part Brand and Part Number below product name -->
            <div name="options" position="after">
                <group invisible="not itx_is_vehicle_part" class="mt-2">
                    <group>
                        <field name="itx_part_brand" placeholder="e.g., Denso, Bosch, OEM"/>
                        <field name="itx_part_number" placeholder="Part manufacturer number"/>
                    </group>
                </group>
            </div>

            <!-- Add Vehicle Part page in notebook -->
            <page name="sales" position="before">
                <page string="Vehicle Part" name="vehicle_part"
                      invisible="not itx_is_vehicle_part">
                    <group>
                        <group string="Vehicle Spec">
                            <field name="itx_spec_id"
                                   required="itx_is_vehicle_part"
                                   options="{'no_create': True}"
                                   placeholder="Select vehicle spec..."/>
                            <field name="itx_brand_id" readonly="1"/>
                            <field name="itx_model_id" readonly="1"/>
                            <field name="itx_generation_id" readonly="1"/>
                        </group>
                        <group string="Part Information">
                            <field name="itx_part_name_id"
                                   required="itx_is_vehicle_part"
                                   placeholder="Select part name..."
                                   options="{'no_quick_create': True}"/>
                            <field name="itx_part_category_id"
                                   options="{'no_create': True}"/>
                            <field name="itx_oem_part_number"
                                   placeholder="(optional, fill later)"/>
                            <field name="itx_sequence"/>
                            <field name="itx_base_code" readonly="1"/>
                        </group>
                    </group>
                    <group string="Compatible Specs">
                        <field name="itx_compatible_spec_ids" nolabel="1"
                               widget="many2many_tags"
                               options="{'no_create': True}"
                               placeholder="Add compatible vehicle specs..."/>
                    </group>
                </page>
            </page>
        </field>
    </record>

    <!-- Inherit Product Template Search View -->
    <record id="product_template_search_view_vehicle_part" model="ir.ui.view">
        <field name="name">product.template.search.vehicle.part</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <field name="categ_id" position="after">
                <field name="itx_spec_id"/>
                <field name="itx_brand_id"/>
                <field name="itx_model_id"/>
                <field name="itx_generation_id"/>
                <field name="itx_part_name_id"/>
                <field name="itx_part_category_id"/>
                <field name="itx_part_brand"/>
                <field name="itx_part_number"/>
                <field name="itx_oem_part_number"/>
            </field>
            <filter name="filter_to_sell" position="after">
                <filter string="Vehicle Parts" name="vehicle_parts"
                        domain="[('itx_is_vehicle_part', '=', True)]"/>
                <separator/>
                <!-- Origin/Condition filters removed — now in product variants -->
            </filter>
            <filter name="group_by_categ_id" position="after">
                <filter string="Vehicle Spec" name="groupby_spec"
                        context="{'group_by': 'itx_spec_id'}"/>
                <filter string="Brand" name="groupby_brand"
                        context="{'group_by': 'itx_brand_id'}"/>
                <filter string="Model" name="groupby_model"
                        context="{'group_by': 'itx_model_id'}"/>
                <filter string="Part Category" name="groupby_part_category"
                        context="{'group_by': 'itx_part_category_id'}"/>
                <filter string="Part Name" name="groupby_part_name"
                        context="{'group_by': 'itx_part_name_id'}"/>
                <filter string="Part Brand" name="groupby_part_brand"
                        context="{'group_by': 'itx_part_brand'}"/>
                <!-- Origin/Condition group-by removed — now in product variants -->
            </filter>
        </field>
    </record>

    <!-- Action for Vehicle Parts -->
    <record id="product_template_action_vehicle_parts" model="ir.actions.act_window">
        <field name="name">Vehicle Parts</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('itx_is_vehicle_part', '=', True)]</field>
        <field name="context">{'default_itx_is_vehicle_part': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first vehicle part
            </p>
            <p>
                Vehicle parts are products with vehicle compatibility information.
            </p>
        </field>
    </record>

    <!-- Action View: Use custom list view -->
    <record id="product_template_action_vehicle_parts_view_list" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="product_template_view_list_vehicle_parts"/>
        <field name="act_window_id" ref="product_template_action_vehicle_parts"/>
    </record>

</odoo>
