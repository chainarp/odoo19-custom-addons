<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List View -->
    <record id="itx_info_vehicle_generation_view_list" model="ir.ui.view">
        <field name="name">itx.info.vehicle.generation.view.list</field>
        <field name="model">itx.info.vehicle.generation</field>
        <field name="arch" type="xml">
            <list string="Vehicle Generations">
                <field name="brand_id"/>
                <field name="model_id"/>
                <field name="code"/>
                <field name="abbr"/>
                <field name="name"/>
                <field name="chassis_code" optional="show"/>
                <field name="year_start"/>
                <field name="year_end"/>
                <field name="spec_count" string="Specs"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="itx_info_vehicle_generation_view_form" model="ir.ui.view">
        <field name="name">itx.info.vehicle.generation.view.form</field>
        <field name="model">itx.info.vehicle.generation</field>
        <field name="arch" type="xml">
            <form string="Vehicle Generation">
                <sheet>
                    <field name="active" invisible="True"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g., Gen 8 (FD)"/>
                        </h1>
                        <h4>
                            <field name="full_name" readonly="True"/>
                        </h4>
                    </div>
                    <group>
                        <group>
                            <field name="model_id"/>
                            <field name="brand_id" readonly="True"/>
                            <field name="code" placeholder="e.g., FD1"/>
                            <field name="abbr" placeholder="e.g., FD"/>
                        </group>
                        <group>
                            <field name="chassis_code" placeholder="e.g., FD1/FD2"/>
                            <field name="year_start"/>
                            <field name="year_end" placeholder="0 = still in production"/>
                            <field name="spec_count" readonly="True"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="desc" placeholder="Additional description..."/>
                        </page>
                        <page string="Specs" name="specs">
                            <field name="spec_ids" widget="one2many">
                                <list create="1">
                                    <field name="code"/>
                                    <field name="abbr"/>
                                    <field name="name"/>
                                    <field name="body_type_id"/>
                                    <field name="engine_id"/>
                                    <field name="transmission"/>
                                    <field name="drive_type"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="itx_info_vehicle_generation_view_search" model="ir.ui.view">
        <field name="name">itx.info.vehicle.generation.view.search</field>
        <field name="model">itx.info.vehicle.generation</field>
        <field name="arch" type="xml">
            <search string="Search Generations">
                <field name="name"/>
                <field name="code"/>
                <field name="abbr"/>
                <field name="chassis_code"/>
                <field name="brand_id"/>
                <field name="model_id"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <filter string="Still in Production" name="in_production" domain="[('year_end', '=', 0)]"/>
                <group>
                    <filter string="Brand" name="groupby_brand" domain="[]" context="{'group_by': 'brand_id'}"/>
                    <filter string="Model" name="groupby_model" domain="[]" context="{'group_by': 'model_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="itx_info_vehicle_generation_action" model="ir.actions.act_window">
        <field name="name">Vehicle Generations</field>
        <field name="res_model">itx.info.vehicle.generation</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="itx_info_vehicle_generation_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first vehicle generation
            </p>
            <p>
                Define generations like Gen 8 (FD) 2006-2011, Gen 9 (FB) 2012-2015, etc.
            </p>
        </field>
    </record>

</odoo>
