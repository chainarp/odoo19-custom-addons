<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="part_origin_oem" model="itx.info.vehicle.part.origin">
            <field name="code">OEM</field>
            <field name="name">OEM (แท้)</field>
            <field name="abbr">OEM</field>
            <field name="desc">Original Equipment Manufacturer - อะไหล่แท้จากโรงงาน</field>
            <field name="sequence">10</field>
            <field name="is_default" eval="True"/>
            <field name="attribute_value_id" ref="attr_val_origin_oem"/>
        </record>

        <record id="part_origin_aftermarket" model="itx.info.vehicle.part.origin">
            <field name="code">AFT</field>
            <field name="name">Aftermarket (เทียม)</field>
            <field name="abbr">AFT</field>
            <field name="desc">อะไหล่เทียบ/ทดแทน จากผู้ผลิตอื่น</field>
            <field name="sequence">20</field>
            <field name="attribute_value_id" ref="attr_val_origin_aft"/>
        </record>

        <record id="part_origin_reconditioned" model="itx.info.vehicle.part.origin">
            <field name="code">REC</field>
            <field name="name">Reconditioned (รีบิ้วท์)</field>
            <field name="abbr">REC</field>
            <field name="desc">อะไหล่ที่ผ่านการซ่อมแซม/ปรับปรุงสภาพใหม่</field>
            <field name="sequence">30</field>
            <field name="attribute_value_id" ref="attr_val_origin_rec"/>
        </record>

    </data>
</odoo>
