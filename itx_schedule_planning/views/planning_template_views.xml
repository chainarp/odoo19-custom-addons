<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List View -->
    <record id="itx_schedule_planning_template_view_list" model="ir.ui.view">
        <field name="name">itx.schedule.planning.template.view.list</field>
        <field name="model">itx.schedule.planning.template</field>
        <field name="arch" type="xml">
            <list string="Planning Templates">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="pattern_id"/>
                <field name="shifts_per_day"/>
                <field name="rotation_direction"/>
                <field name="shift_duration"/>
                <field name="is_default"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="itx_schedule_planning_template_view_form" model="ir.ui.view">
        <field name="name">itx.schedule.planning.template.view.form</field>
        <field name="model">itx.schedule.planning.template</field>
        <field name="arch" type="xml">
            <form string="Planning Template">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <widget name="web_ribbon" title="Default" bg_color="text-bg-success" invisible="not is_default"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g., 3 Shifts 4 Teams Rotation"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Basic Information">
                            <field name="code" placeholder="e.g., 3S4T"/>
                            <field name="sequence"/>
                            <field name="is_default"/>
                            <field name="active"/>
                        </group>
                        <group string="Work-Off Pattern">
                            <field name="pattern_id"/>
                            <field name="work_days" readonly="1"/>
                            <field name="off_days" readonly="1"/>
                            <field name="pattern_length" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Rotation Settings">
                            <field name="rotation_direction"/>
                            <field name="rotation_period_count" invisible="rotation_direction == 'none'"/>
                            <field name="shifts_per_day"/>
                        </group>
                        <group string="Shift Duration">
                            <field name="shift_duration"/>
                            <field name="break_duration"/>
                            <field name="total_shift_hours" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Day Break Pattern">
                            <field name="day_break_pattern"/>
                            <field name="day_break_work_before" invisible="day_break_pattern != 'custom'"/>
                            <field name="day_break_work_after" invisible="day_break_pattern != 'custom'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description" placeholder="Detailed description of this template..."/>
                        </page>
                        <page string="Shift Times" name="shift_times">
                            <field name="shift_time_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="hour_start" widget="float_time"/>
                                    <field name="hour_end" widget="float_time"/>
                                    <field name="is_overnight"/>
                                    <field name="color" widget="color_picker"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="itx_schedule_planning_template_view_search" model="ir.ui.view">
        <field name="name">itx.schedule.planning.template.view.search</field>
        <field name="model">itx.schedule.planning.template</field>
        <field name="arch" type="xml">
            <search string="Search Planning Templates">
                <field name="name"/>
                <field name="code"/>
                <field name="pattern_id"/>
                <filter string="Default" name="default" domain="[('is_default', '=', True)]"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <separator/>
                <filter string="Pattern" name="group_pattern" context="{'group_by': 'pattern_id'}"/>
                <filter string="Direction" name="group_direction" context="{'group_by': 'rotation_direction'}"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="itx_schedule_planning_template_action" model="ir.actions.act_window">
        <field name="name">Planning Templates</field>
        <field name="res_model">itx.schedule.planning.template</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Planning Template
            </p>
            <p>
                Planning templates define how schedules are generated, including
                shift rotation, work-off patterns, and shift times.
            </p>
        </field>
    </record>

</odoo>
