<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List View -->
    <record id="itx_schedule_shift_type_view_list" model="ir.ui.view">
        <field name="name">itx.schedule.shift.type.view.list</field>
        <field name="model">itx.schedule.shift.type</field>
        <field name="arch" type="xml">
            <list string="Shift Types">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="hour_start" widget="float_time"/>
                <field name="hour_end" widget="float_time"/>
                <field name="duration"/>
                <field name="is_overnight"/>
                <field name="is_day_off"/>
                <field name="color" widget="color_picker"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="itx_schedule_shift_type_view_form" model="ir.ui.view">
        <field name="name">itx.schedule.shift.type.view.form</field>
        <field name="model">itx.schedule.shift.type</field>
        <field name="arch" type="xml">
            <form string="Shift Type">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <widget name="web_ribbon" title="Day Off" bg_color="text-bg-secondary" invisible="not is_day_off"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g., Morning Shift"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" placeholder="e.g., MORNING"/>
                            <field name="is_day_off"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="hour_start" widget="float_time" invisible="is_day_off"/>
                            <field name="hour_end" widget="float_time" invisible="is_day_off"/>
                            <field name="duration" invisible="is_day_off"/>
                            <field name="is_overnight" invisible="is_day_off"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="color" widget="color_picker"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="itx_schedule_shift_type_view_search" model="ir.ui.view">
        <field name="name">itx.schedule.shift.type.view.search</field>
        <field name="model">itx.schedule.shift.type</field>
        <field name="arch" type="xml">
            <search string="Search Shift Types">
                <field name="name"/>
                <field name="code"/>
                <filter string="Day Off" name="day_off" domain="[('is_day_off', '=', True)]"/>
                <filter string="Overnight" name="overnight" domain="[('is_overnight', '=', True)]"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="itx_schedule_shift_type_action" model="ir.actions.act_window">
        <field name="name">Shift Types</field>
        <field name="res_model">itx.schedule.shift.type</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Shift Type
            </p>
            <p>
                Define shift types like Morning (06:00-14:00), Afternoon (14:00-22:00),
                Night (22:00-06:00), and Day Off.
            </p>
        </field>
    </record>

</odoo>
