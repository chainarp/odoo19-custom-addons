<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ========================== -->
    <!-- Schedule Planning (Header) -->
    <!-- ========================== -->

    <!-- Form View -->
    <record id="view_schedule_planning_form" model="ir.ui.view">
        <field name="name">itx.schedule.planning.form</field>
        <field name="model">itx.schedule.planning</field>
        <field name="arch" type="xml">
            <form string="Schedule Planning">
                <header>
                    <button name="action_publish"
                            string="Publish"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_activate"
                            string="Activate"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'published'"/>
                    <button name="action_archive"
                            string="Archive"
                            type="object"
                            invisible="state not in ('published', 'active')"/>
                    <button name="action_reset_to_draft"
                            string="Reset to Draft"
                            type="object"
                            invisible="state != 'published'"/>
                    <button name="action_clone"
                            string="Clone"
                            type="object"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,published,active,archived"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(itx_schedule_planning.action_schedule_planning_workrole)d"
                                type="action"
                                class="oe_stat_button"
                                icon="fa-users"
                                context="{'default_planning_id': id, 'search_default_planning_id': id}">
                            <field name="workrole_count" widget="statinfo" string="Work Roles"/>
                        </button>
                        <button class="oe_stat_button" icon="fa-calendar" type="object" name="action_view_entries">
                            <field name="total_entries" widget="statinfo" string="Entries"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="e.g., Schedule March 2026"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Period">
                            <field name="period_id"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                        </group>
                        <group string="Information">
                            <field name="version"/>
                            <field name="parent_id" invisible="not parent_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="total_employees"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Work Roles" name="workroles">
                            <field name="workrole_ids" context="{'default_planning_id': id}">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="workrole_id"/>
                                    <field name="template_id"/>
                                    <field name="responsible_id"/>
                                    <field name="min_employees_per_shift"/>
                                    <field name="employee_count"/>
                                    <field name="entry_count"/>
                                </list>
                            </field>
                        </page>
                        <page string="Workflow History" name="history">
                            <group>
                                <group string="Published">
                                    <field name="published_date"/>
                                    <field name="published_by"/>
                                </group>
                                <group string="Activated">
                                    <field name="activated_date"/>
                                    <field name="activated_by"/>
                                </group>
                                <group string="Archived">
                                    <field name="archived_date"/>
                                    <field name="archived_by"/>
                                </group>
                            </group>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note" placeholder="Internal notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="view_schedule_planning_list" model="ir.ui.view">
        <field name="name">itx.schedule.planning.list</field>
        <field name="model">itx.schedule.planning</field>
        <field name="arch" type="xml">
            <list string="Schedule Planning" decoration-info="state == 'draft'"
                  decoration-success="state == 'active'" decoration-muted="state == 'archived'">
                <field name="name"/>
                <field name="period_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="workrole_count"/>
                <field name="total_employees"/>
                <field name="total_entries"/>
                <field name="version"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'published'"
                       decoration-success="state == 'active'"
                       decoration-muted="state == 'archived'"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_schedule_planning_search" model="ir.ui.view">
        <field name="name">itx.schedule.planning.search</field>
        <field name="model">itx.schedule.planning</field>
        <field name="arch" type="xml">
            <search string="Schedule Planning">
                <field name="name"/>
                <field name="period_id"/>
                <separator/>
                <filter string="Draft" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Published" name="filter_published" domain="[('state', '=', 'published')]"/>
                <filter string="Active" name="filter_active" domain="[('state', '=', 'active')]"/>
                <filter string="Archived" name="filter_archived" domain="[('state', '=', 'archived')]"/>
                <separator/>
                <filter string="Current Period" name="filter_current"
                        domain="[('date_start', '&lt;=', context_today().strftime('%Y-%m-%d')),
                                 ('date_end', '&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter string="Group by State" name="group_state" context="{'group_by': 'state'}"/>
                <filter string="Group by Period" name="group_period" context="{'group_by': 'period_id'}"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_schedule_planning" model="ir.actions.act_window">
        <field name="name">Schedule Planning</field>
        <field name="res_model">itx.schedule.planning</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_schedule_planning_search"/>
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Schedule Planning
            </p>
            <p>
                Plan work schedules for your 24/7 operations team.
            </p>
        </field>
    </record>

</odoo>
